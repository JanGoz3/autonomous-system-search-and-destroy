from ultralytics import YOLO

model = YOLO('yolo26m.pt') 

if __name__ == '__main__':
    results = model.train(
        data='data/data.yaml', 
        epochs=50,      
        imgsz=640,       
        batch=16,        
        device=0, 
        name='drzwi_model_v1' # Nazwa folderu, w którym zapiszą się wyniki
    )